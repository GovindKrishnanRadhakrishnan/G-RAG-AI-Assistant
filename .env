PROJECT_NAME=G-RAG AI Assistant
VERSION=2.1.0
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_KEEP_ALIVE=10m
LLM_NUM_PREDICT=192
VECTOR_DB_PATH=vector_db

# Faster defaults for low-RAM machines
TOP_K_RETRIEVAL=6
TOP_K_FINAL=3
ENABLE_QUERY_REWRITE=false
ENABLE_RERANK=false
ENABLE_COMPRESSION=false
RUN_EVALUATION=false
DEBUG_MODE=false

# Safety PIN for the Reset button (deletes all documents)
RESET_DOCUMENTS_PIN=1234
