# G-RAG local configuration
# Copy to `.env` and adjust as needed. Never commit `.env`.

PROJECT_NAME=G-RAG AI Assistant
VERSION=2.1.0

# Ollama
OLLAMA_HOST=http://localhost:11434
# Prefer llama3.2:1b for better answers on low-RAM machines.
# tinyllama also works but often ignores the document context.
# phi3:mini needs ~5 GiB free and will fail with a 500 memory error here.
OLLAMA_MODEL=llama3.2:1b
# Keep model loaded between requests ("10m", "-1" forever, "0" unload)
OLLAMA_KEEP_ALIVE=10m
# Shorter answers = faster generation
LLM_NUM_PREDICT=192

# Vector store (keep existing path to preserve your Chroma data)
VECTOR_DB_PATH=vector_db

# Document chunking
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Retrieval (smaller = faster)
TOP_K_RETRIEVAL=6
TOP_K_FINAL=3
COMPRESSION_THRESHOLD=0.3
MEMORY_TURNS=5

# Embedding / re-ranking models (HuggingFace / sentence-transformers)
EMBED_MODEL=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Speed toggles — leave false for fast local use; set true for max quality
ENABLE_QUERY_REWRITE=false
ENABLE_RERANK=false
ENABLE_COMPRESSION=false

# Behavior
# Evaluation adds 2 extra Ollama calls per question — keep false on low RAM
RUN_EVALUATION=false
DEBUG_MODE=false

# Safety PIN for the Reset button (deletes all documents)
RESET_DOCUMENTS_PIN=1234
